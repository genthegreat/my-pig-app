# Copy to .env in the project folder, or keep it anywhere and point at it:
#   docker compose --env-file /path/to/pigs.env up -d --build
#   ENV_FILE=/path/to/pigs.env pnpm start
# Port to publish the app on (plain http)
PORT=3000
# Only for `docker compose --profile https`: the DNS name Caddy should get a certificate for
DOMAIN=

# ── Signing in ──────────────────────────────────────────────────────────────
# The public address of the app. Password-reset links are built from it.
APP_URL=
# Invite code needed to create an account. Leave empty and only the very first
# account can be created (it owns the farm); after that sign-up is closed.
SIGNUP_CODE=
# Mail server for password-reset emails, e.g. smtp://user:pass@smtp.example.com:587
# Leave empty and reset links are printed to the server log instead.
SMTP_URL=
# The From line on those emails, e.g. My Pigs <pigs@example.com>
MAIL_FROM=
# Set to 1 when a reverse proxy (Caddy, nginx) sits in front of the app
TRUST_PROXY=
