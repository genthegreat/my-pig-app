# My Pigs settings. Copy to .env in the project folder, next to docker-compose.yml;
# `docker compose up` and `pnpm start` both read it on their own.
# Keep it off git and off any public place — it holds the mail password.
#
# Quoting: wrap a value in 'single quotes' if it has a $ or a space in it
# (a mail password often does). Unquoted, Docker eats the $.
# After changing anything here: docker compose up -d   (or restart pnpm start)

# ── Where it answers ────────────────────────────────────────────────────────
# Port published on this machine. Behind your own nginx, keep it off the
# network: PORT=127.0.0.1:8090
PORT=3000
# The public address people open, e.g. https://pigs.example.com.
# Password-reset links are built from it.
APP_URL=
# 1 when a reverse proxy (your own nginx, or the Caddy profile) is in front.
TRUST_PROXY=
# Only for `docker compose --profile https`: the DNS name Caddy gets a
# certificate for, e.g. pigs.example.com
DOMAIN=

# ── Who may sign up ─────────────────────────────────────────────────────────
# Anyone creating an account must type this. Give it to the people you want
# in; change it to stop new sign-ups with the old one. Empty: only the very
# first account can be created, then sign-up closes.
SIGNUP_CODE=

# ── Password-reset email ────────────────────────────────────────────────────
# Your mail provider's SMTP server: 'smtp://user:password@host:587'
# (port 465: 'smtps://…'). Empty: reset links are printed to the server log
# instead (docker compose logs app) for you to pass on.
SMTP_URL=
# The From line, e.g. My Pigs <pigs@example.com>
MAIL_FROM=
