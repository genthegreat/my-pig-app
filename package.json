{
  "name": "my-pigs-app",
  "version": "0.1.0",
  "private": true,
  "description": "Farm management for a commercial piggery. Offline-first PWA.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/gen-seed.mjs && next dev",
    "build": "node scripts/gen-seed.mjs && next build && node scripts/build-sw.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/gen-seed.mjs && vitest run",
    "typecheck": "node scripts/gen-seed.mjs && tsc --noEmit",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
