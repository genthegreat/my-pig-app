{
  "name": "my-pigs-app",
  "version": "0.1.0",
  "private": true,
  "description": "Farm management for a commercial piggery. Offline-first PWA.",
  "scripts": {
    "predev": "node scripts/gen-seed.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-seed.mjs",
    "build": "next build",
    "postbuild": "node scripts/build-sw.mjs",
    "start": "node scripts/serve.mjs",
    "pretest": "node scripts/gen-seed.mjs",
    "test": "vitest run",
    "typecheck": "node scripts/gen-seed.mjs && tsc --noEmit",
    "gen:icons": "node scripts/gen-icons.mjs",
    "e2e": "node private/e2e.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.5",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
